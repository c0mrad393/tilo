// The page tiloart.com shows now that Tilo has closed: static files only, no server behind
// them. Deployed in place of the app's Worker, under the same name, with
// `npx wrangler deploy -c closed/wrangler.jsonc`. Every address shows the closing page.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tilo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application"
  }
}
