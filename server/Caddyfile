# One origin for everything, so the app needs no CORS.
# SITE_ADDRESS is ":8000" on this computer; on the server it becomes the domain.
{
	admin off
}

{$SITE_ADDRESS::8000} {
	encode zstd gzip

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle /api/* {
		reverse_proxy api:8787
	}

	# link previews: a crawler gets a small page with Open Graph tags instead of the app,
	# which only draws itself in a browser
	@preview {
		path /piece/* /u/*
		header_regexp User-Agent (?i)(bot|crawler|spider|preview|facebookexternalhit|meta-externalagent|whatsapp|telegram|slack|discord|skype|embedly|iframely|pinterest|vkshare|mastodon|bluesky|signal)
	}
	handle @preview {
		rewrite * /api/og{path}
		reverse_proxy api:8787
	}

	# recordings and pictures; a file never changes once written
	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	# the built app (dist/), with every other path left to the router
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}

# inside the compose network only (no published port): the email templates Auth fetches
http://:8080 {
	root * /srv/mail
	file_server
}
