# Settings for backup.sh. install.sh copies this to /etc/tilo/backup.env (mode 600, owned
# by tilo); fill it in there, on the server. Never commit the filled-in file.

# the public half of the backup key (age1...). Make the pair on your own computer with
# `age-keygen -o tilo-backup.key`; the private key goes in a password manager, never here.
AGE_RECIPIENT=

# where the code is and what compose calls the stack
TILO_DIR=/home/tilo/tilo
COMPOSE_PROJECT=tilo

# Cloudflare R2: the account id (R2's overview page), the bucket, and an API token made
# under R2 > Manage API tokens with "Object Read & Write" on that bucket only
R2_ACCOUNT_ID=
R2_BUCKET=tilo-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# optional: a check that expects a ping every day (healthchecks.io, or an UptimeRobot
# heartbeat), so a night without a backup sends an email
BACKUP_PING_URL=
