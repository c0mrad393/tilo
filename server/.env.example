# Every setting the server reads. `node scripts/setup-env.mjs` copies this to .env and fills
# in the secrets (left empty here). Never commit .env. Values below are for this computer.

# where people reach the site; Auth's links (emails, sign-in redirects) start with it.
# Locally that's the Vite dev server, which proxies /auth, /rest, /api and /files to Caddy.
PUBLIC_URL=http://localhost:4640
SITE_URL=http://localhost:4640
REDIRECT_URLS=http://localhost:4640/**

# Caddy: what it answers to, and where its port is published on the host
SITE_ADDRESS=:8000
CADDY_BIND=127.0.0.1:8000

# secrets: generated
POSTGRES_PASSWORD=
JWT_SECRET=
# public key for the app (role anon), and the admin key that bypasses every rule (role
# service_role, never leaves the server); both are tokens signed with JWT_SECRET
ANON_KEY=
SERVICE_ROLE_KEY=

# how long a session token lasts, in seconds; the app refreshes it
JWT_EXPIRY=3600

# services that run only on this computer: "local" adds Mailpit, which catches every email
# Auth sends (read them at http://localhost:8025). Leave empty on the server.
COMPOSE_PROFILES=local

# mail. Locally it all goes to Mailpit; on the server, to the SMTP provider (Resend, Brevo).
# MAIL_AUTOCONFIRM=true would skip the confirmation email altogether; keep it false.
MAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=hello@tiloart.com
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Tilo
# emails Auth may send per hour, across everyone
MAIL_RATE_LIMIT=100

# Google sign-in: a web OAuth client from console.cloud.google.com, with the redirect URI
# {PUBLIC_URL}/auth/v1/callback. The app shows the Google button only when this is true.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# load seed/ (local invite codes) after the migrations
SEED=true
# publish the prototype's sample pieces as @tilo, once per database
SAMPLES=true

# how many pieces one member may publish in 24 hours
PUBLISH_PER_DAY=20
