# Every setting the server reads. `node scripts/setup-env.mjs` copies this to .env and fills
# in the secrets (left empty here). Never commit .env. Values below are for this computer.

# where people reach the site; Auth's links (emails, sign-in redirects) start with it.
# Locally that's the Vite dev server, which proxies /auth, /rest, /api and /files to Caddy.
PUBLIC_URL=http://localhost:4640
SITE_URL=http://localhost:4640
REDIRECT_URLS=http://localhost:4640/**

# Caddy: what it answers to, and where its port is published on the host
SITE_ADDRESS=:8000
CADDY_BIND=127.0.0.1:8000

# secrets: generated
POSTGRES_PASSWORD=
JWT_SECRET=
# public key for the app (role anon), and the admin key that bypasses every rule (role
# service_role, never leaves the server); both are tokens signed with JWT_SECRET
ANON_KEY=
SERVICE_ROLE_KEY=

# how long a session token lasts, in seconds; the app refreshes it
JWT_EXPIRY=3600

# mail: autoconfirm skips the confirmation email, for this computer only
MAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=hello@tiloart.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Tilo

# load seed/ (local invite codes) after the migrations
SEED=true
