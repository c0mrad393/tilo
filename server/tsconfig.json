{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "typeRoots": ["./api/node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@napi-rs/canvas": ["./api/node_modules/@napi-rs/canvas"] }
  },
  "include": ["api/src", "scripts/*.ts"]
}
