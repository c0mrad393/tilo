{
  "name": "tilo",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4640 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4641 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server:up": "docker compose -f server/docker-compose.yml up -d --build --wait",
    "server:down": "docker compose -f server/docker-compose.yml down",
    "server:logs": "docker compose -f server/docker-compose.yml logs -f",
    "server:check": "tsc -p server",
    "server:smoke": "node --experimental-strip-types --no-warnings server/scripts/smoke.ts",
    "server:deploy": "bash server/scripts/deploy.sh",
    "video": "esbuild marketing/make-video.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=server/api/dist/make-video.mjs && node server/api/dist/make-video.mjs",
    "samples": "esbuild server/scripts/make-samples.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=server/api/dist/make-samples.mjs && node server/api/dist/make-samples.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/martian-mono": "5.2.7",
    "@supabase/auth-js": "2.118.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "axe-core": "4.10.3",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "wrangler": "4.151.3"
  }
}
