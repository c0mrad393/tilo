// tiloart.com since Tilo closed (27 November 2026): the closing page only, static files with
// no server behind them, under the Worker's old name. Every address shows the page.
// The app's own Worker, as it ran until then, is wrangler.app.jsonc:
// `npm run build && npx wrangler deploy -c wrangler.app.jsonc`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./closed/site",
    "not_found_handling": "single-page-application"
  }
}
